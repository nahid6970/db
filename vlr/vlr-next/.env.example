# Convex deployment URL (from: npx convex dev or Convex dashboard)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# Convex HTTP action secret (set same value in Convex dashboard env vars)
# Protects the /ingest-matches and /upsert-match endpoints
CONVEX_SECRET=your-random-secret-here

# Convex site URL for the scraper HTTP endpoint
# (from Convex dashboard → Settings → URL & Deploy Key)
CONVEX_SITE_URL=https://your-deployment.convex.site
