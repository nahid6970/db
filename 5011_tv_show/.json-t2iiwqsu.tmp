            {
                "season_number": 1,
                "episode_number": 103,
                "title": "Release from Misfortune",
                "air_date": "2019-10-01",
                "airtime": "15:25",
                "air_datetime": "2019-10-01T09:25:00+00:00",
                "overview": "The Father and the other villagers of Hage Village are attacked by a Magic Knight from the Purple Orcas who had reincarnated as an elf who uses poison plant magic. Asta and Yuno try to save the villagers but they can't seem to find a way to break the spell. During their battle the sword that Licht had taken out of the ground of the floating dungeon suddenly appears out of Asta's grimoire. Asta takes it in hand and realizes that it's much more powerful than he can control easily.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/213/534791.jpg",
