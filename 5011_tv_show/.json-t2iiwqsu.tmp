                "title": "Episode 7",
                "air_date": "2022-12-22",
                "airtime": "18:00",
                "air_datetime": "2022-12-22T12:00:00+00:00",
                "overview": "In the middle of an overgrown Shibuya crossing, Niragi challenges Arisu and Chishiya to a game. But then, the King of Spades arrives.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/436/1090793.jpg",
                "tvmaze_episode_id": 2401617,
                "id": 15,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 2,
                "episode_number": 6,
                "title": "Episode 6",
                "air_date": "2022-12-22",
                "airtime": "18:00",
                "air_datetime": "2022-12-22T12:00:00+00:00",
                "overview": "Usagi will have to change the hearts and minds of the cynical players on the Queen's team. At the Supreme Court, Chishiya meets the King of Diamonds.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/436/1090792.jpg",
                "tvmaze_episode_id": 2401616,
                "id": 14,
                "watched": true,
                "notify": "seen"
            },
            {
