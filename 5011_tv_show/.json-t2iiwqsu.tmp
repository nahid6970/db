                "episode_number": 5,
                "title": "Traahi",
                "air_date": "2024-07-05",
                "airtime": "18:00",
                "air_datetime": "2024-07-05T12:00:00+00:00",
                "overview": "Golu plans an attack outside Mirzapur without Guddu. Guddu returns from Nepal to find Golu missing. Sharad senses something is amiss in Siwan and decides to shift his most guarded secret to Jaunpur.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/526/1315873.jpg",
                "tvmaze_episode_id": 2914298,
