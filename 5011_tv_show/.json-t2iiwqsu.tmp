            {
                "season_number": 7,
                "episode_number": 1,
                "title": "In the Nick of Time! A Big-Time Maverick from the West!",
                "air_date": "2024-05-04",
                "airtime": "14:30",
                "air_datetime": "2024-05-04T08:30:00+00:00",
                "overview": "As jailbreakers run rampant in Japan, Star and Stripe flies from the U.S. to Japan to help and finds Shigaraki waiting for her in the middle of her flight path.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/645/1612761.jpg",
                "tvmaze_episode_id": 2715762,
                "id": 139,
                "watched": true,
