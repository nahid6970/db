            {
                "season_number": 2,
                "episode_number": 11,
                "title": "The Varieties of Pride",
                "air_date": "2019-06-25",
                "airtime": "22:05",
                "air_datetime": "2019-06-25T16:05:00+00:00",
                "overview": "Garou is at last surrounded by multiple heroes and forced to fight, even though he's covered in wounds and nearly at his limit. The hero hunter still has his incredible ability to read opponents' fighting styles, but there are surprises in store for all.",
