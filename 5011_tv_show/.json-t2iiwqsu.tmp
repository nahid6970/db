                "air_date": "2021-05-13",
                "airtime": "18:00",
                "air_datetime": "2021-05-13T12:00:00+00:00",
                "overview": "Not content to live in a cage, Lenore chooses another fate. Alucard opens his castle. Sypha wonders if she's lost Belmont for good.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/316/790565.jpg",
