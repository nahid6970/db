            {
                "season_number": 1,
                "episode_number": 6,
                "title": "Knight of Rebellion",
                "air_date": "2017-08-05",
                "airtime": "21:00",
                "air_datetime": "2017-08-05T15:00:00+00:00",
                "overview": "",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/125/314844.jpg",
