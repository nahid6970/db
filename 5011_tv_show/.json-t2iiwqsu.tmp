            },
            {
                "season_number": 5,
                "episode_number": 12,
                "title": "Astrea Record | Inheritance",
                "air_date": "2025-02-23",
                "airtime": "19:00",
                "air_datetime": "2025-02-23T13:00:00+00:00",
                "overview": "Defeat is imminent. As the allied army falls, they need a miracle to win. But just as all hope fades, a gale-force wind begins to howl.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/555/1387575.jpg",
                "tvmaze_episode_id": 3019889,
                "id": 71,
                "watched": false,
                "notify": "seen"
            },
            {
                "season_number": 5,
                "episode_number": 11,
                "title": "F\u00f3lkvangr | Hell",
                "air_date": "2024-12-19",
                "airtime": "21:30",
                "air_datetime": "2024-12-19T15:30:00+00:00",
                "overview": "The Hestia Familia may have formed an alliance for the War Game, but the Freya Familia earned its fearsome reputation for a reason. The allied army is about to find out why.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/548/1371117.jpg",
                "tvmaze_episode_id": 3019888,
                "id": 70,
