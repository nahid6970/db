                "title": "Einherjar | The Warriors of the Goddess",
                "air_date": "2025-03-30",
                "airtime": "19:00",
                "air_datetime": "2025-03-30T13:00:00+00:00",
                "overview": "Only two adventurers stand between the allied army and Freya. Unfortunately, Ottarl and Allen are the Freya Familia's most formidable warriors.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/557/1393980.jpg",
