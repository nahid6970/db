                "episode_number": 7,
                "title": "The Self-Preservation Society",
                "air_date": "2019-07-26",
                "airtime": "18:00",
                "air_datetime": "2019-07-26T12:00:00+00:00",
                "overview": "Billy has a meeting of minds with Mesmer after learning that he burned the Boys. The Deep adjusts to life in Sandusky, and Starlight learns the truth about Hughie.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/206/515954.jpg",
                "tvmaze_episode_id": 1665501,
                "id": 7,
                "watched": true,
