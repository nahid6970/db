            },
            {
                "season_number": 1,
                "episode_number": 11,
                "title": "Mission Start",
                "air_date": "2022-12-20",
                "airtime": "21:00",
                "air_datetime": "2022-12-20T15:00:00+00:00",
                "overview": "Denji and Power complete their training with Kishibe, while Aki Hayakawa makes a new contract with the \"Future Devil\" through Kurose and Tendo.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618256.jpg",
                "tvmaze_episode_id": 2409321,
                "id": 11,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 10,
                "title": "Bruised & Battered",
                "air_date": "2022-12-13",
                "airtime": "21:00",
                "air_datetime": "2022-12-13T15:00:00+00:00",
                "overview": "Samurai Sword's vicious attack resulted in many lost personnel for Public Safety Devil Extermination Division 4. Aki Hayakawa wakes up in a hospital bed, unable to accept the reality of losing Himeno.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618255.jpg",
                "tvmaze_episode_id": 2409320,
                "id": 10,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 9,
                "title": "From Kyoto",
                "air_date": "2022-12-06",
                "airtime": "21:00",
                "air_datetime": "2022-12-06T15:00:00+00:00",
                "overview": "A fierce battle unfolds between Denji and the menacing Samurai Sword. But even after Denji takes one of Samurai Sword's companions hostage, Samurai Sword slashes through them both until Denji is captured. Meanwhile, after seemingly being killed, Makima turns out to be alive. She sets out to rescue Denji with the help of Public Safety Devil Hunters from Kyoto, Kurose and Tendo.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618254.jpg",
                "tvmaze_episode_id": 2409319,
                "id": 9,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 8,
                "title": "Gunfire",
                "air_date": "2022-11-29",
                "airtime": "21:00",
                "air_datetime": "2022-11-29T15:00:00+00:00",
                "overview": "Denji experiences his first, yet devastating, kiss. An intoxicated Denji is taken to Himeno's house, where she starts seducing him. Feeling torn between Makima, whom he admires, and Himeno, who is standing in front of him, he decides to fall into temptation. However, Denji then finds something in his pocket: The Chupa Chups lollipop that Makima gave him.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618253.jpg",
                "tvmaze_episode_id": 2409318,
                "id": 8,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 7,
                "title": "The Taste of a Kiss",
                "air_date": "2022-11-22",
                "airtime": "21:00",
                "air_datetime": "2022-11-22T15:00:00+00:00",
                "overview": "Aki gets stabbed by Kobeni while protecting Denji. Seeing this, Denji jumps inside the \"Eternity Devil\" and starts attacking it. He fails to kill the \"Eternity Devil\" and his chainsaw power ends up fading after losing too much blood.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618252.jpg",
                "tvmaze_episode_id": 2409317,
                "id": 7,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 6,
                "title": "Kill Denji",
                "air_date": "2022-11-15",
                "airtime": "21:00",
                "air_datetime": "2022-11-15T15:00:00+00:00",
                "overview": "Denji and Tokyo Special Division 4 members enter a hotel to collect a piece of the Gun Devil. However, they end up being trapped on the 8th floor due to the devil's extraordinary power. With the members being cornered on the endless 8th floor with seemingly no way to escape, the devil makes them an offer: \"If you let me eat Denji, I will let all of the other devil hunters leave in one piece.\"",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618251.jpg",
                "tvmaze_episode_id": 2395538,
                "id": 6,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 5,
                "title": "Gun Devil",
                "air_date": "2022-11-08",
                "airtime": "21:00",
                "air_datetime": "2022-11-08T15:00:00+00:00",
                "overview": "Aki Hayakawa, Denji, and Power start living together. Denji finally fulfills his dream of touching Power's boobs, but is shocked when things do not turn out the way he expected. As Denji realizes that chasing his dream was more fun than achieving it, Makima approaches him and says, \"If you can kill the Gun Devil, I'll grant you one wish.\"",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618250.jpg",
                "tvmaze_episode_id": 2395537,
                "id": 5,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 4,
                "title": "Rescue",
                "air_date": "2022-11-01",
                "airtime": "21:00",
                "air_datetime": "2022-11-01T15:00:00+00:00",
                "overview": "After a fierce battle, Denji defeats the \"Bat Devil\" and rescues Power even after she had trapped him. He says it is all for the sake of \"touching Power's boobs\". Power mocks his ridiculous motivation saying \"that's a pretty dumb reason\", but still agrees to let him fondle her boobs. As Denji gets thrilled with the idea, he faces a sudden attack from out of nowhere...",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618249.jpg",
                "tvmaze_episode_id": 2395536,
                "id": 4,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 3,
                "title": "Meowy's Whereabouts",
                "air_date": "2022-10-25",
                "airtime": "21:00",
                "air_datetime": "2022-10-25T15:00:00+00:00",
                "overview": "Denji decides that his new dream is \"to fondle some boobs.\" His partner, Power the Blood Fiend, offers to let him feel her boobs only if he rescues her old pet cat Meowy from a devil. With his dream in sight, Denji is all fired up and ready to go, until...",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618248.jpg",
                "tvmaze_episode_id": 2395535,
                "id": 3,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 2,
                "title": "Arrival in Tokyo",
                "air_date": "2022-10-18",
                "airtime": "21:00",
                "air_datetime": "2022-10-18T15:00:00+00:00",
                "overview": "After being taken into custody by Makima, one of the Public Safety Devil Hunters, Denji finds himself head over heels in love with her thanks to her suggestive insinuations.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618247.jpg",
                "tvmaze_episode_id": 2395534,
                "id": 2,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 1,
                "title": "Dog & Chainsaw",
                "air_date": "2022-10-11",
                "airtime": "21:00",
                "air_datetime": "2022-10-11T15:00:00+00:00",
                "overview": "Denji is a teenager who lives his life as a Devil Hunter. Aiming to pay off the debt he inherited from his father, he starts hunting devils for the yakuza with his buddy Pochita, a \"Chainsaw Devil\", while living a tragically poor life.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618246.jpg",
                "tvmaze_episode_id": 2375892,
                "id": 1,
