                "title": "The Bloody Doors Off",
                "air_date": "2020-09-25",
                "airtime": "18:00",
                "air_datetime": "2020-09-25T12:00:00+00:00",
                "overview": "When The Boys and Starlight follow a lead to Vought's mysterious Sage Grove Center, they find one of Vought's darkest secrets - and someone even darker from their past. Meanwhile Homelander and Stormfront's relationship deepens.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/275/687576.jpg",
                "tvmaze_episode_id": 1855142,
                "id": 14,
                "watched": true,
