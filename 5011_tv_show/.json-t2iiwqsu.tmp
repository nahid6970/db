                "airtime": "19:00",
                "air_datetime": "2025-02-23T13:00:00+00:00",
                "overview": "Unexpected reinforcements and a sudden betrayal have turned the tide of battle. The allied army now has a chance at victory, but they must fight tooth and nail to seize it.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/555/1387576.jpg",
                "tvmaze_episode_id": 3019890,
                "id": 72,
                "watched": false,
