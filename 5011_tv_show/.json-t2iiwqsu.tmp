            },
            {
                "season_number": 3,
                "episode_number": 2,
                "title": "The Only Man in the Sky",
                "air_date": "2022-06-03",
                "airtime": "18:00",
                "air_datetime": "2022-06-03T12:00:00+00:00",
                "overview": "Homelander. America's greatest Superhero. Defending our shores from sea to shining sea. Today, America honors him on his birthday. And the Vought Shopping Network is celebrating by offering the exclusive Homelander Limited Birthday Edition Gold Coin for only $99.95 (plus tax and shipping) while supplies last. Vought Gold Commemorative Coins: An investment that lasts a lifetime.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/411/1027563.jpg",
                "tvmaze_episode_id": 2248941,
                "id": 18,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 3,
                "episode_number": 1,
                "title": "Payback",
                "air_date": "2022-06-03",
                "airtime": "18:00",
                "air_datetime": "2022-06-03T12:00:00+00:00",
                "overview": "You and a guest are invited to the premiere of DAWN OF THE SEVEN this Tuesday at 7PM in Vought Tower's Lamplighter Memorial Theater! Screening will be followed by a Q&amp;A with director Adam Bourke and an after-party with Supe DJ Malchemical on the turntables! Join us for the greatest true origin story ever told about America's number one Superhero team and see how the legend began!",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/411/1027562.jpg",
                "tvmaze_episode_id": 1950017,
                "id": 17,
                "watched": true,
