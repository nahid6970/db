            },
            {
                "season_number": 4,
                "episode_number": 22,
                "title": "Luvia | Starry Flower",
                "air_date": "2023-03-17",
                "airtime": "21:30",
                "air_datetime": "2023-03-17T15:30:00+00:00",
                "overview": "After five years of grief, guilt and pain, Ryu finally faces a new path\u2014a new justice. The Juggernaut should beware.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/506/1265039.jpg",
                "tvmaze_episode_id": 2464362,
                "id": 59,
                "watched": true,
