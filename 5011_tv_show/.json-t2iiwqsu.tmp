                "episode_number": 3,
                "title": "Odr | Partner",
                "air_date": "2024-10-17",
                "airtime": "21:30",
                "air_datetime": "2024-10-17T15:30:00+00:00",
                "overview": "Bell and Syr finally go on their festival date. Unfortunately, several meddlesome groups insist on being the third wheel.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/541/1354274.jpg",
