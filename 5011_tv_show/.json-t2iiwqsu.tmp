            },
            {
                "season_number": 5,
                "episode_number": 1,
                "title": "Syr | Opening of the Goddess Festival",
                "air_date": "2024-10-03",
                "airtime": "21:30",
                "air_datetime": "2024-10-03T15:30:00+00:00",
                "overview": "Syr is not the only one who has feelings for Bell. When she notices the shift in her friend's behavior, she asks Ryu a question that shakes the elf to the core.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/538/1345148.jpg",
                "tvmaze_episode_id": 3013047,
                "id": 60,
