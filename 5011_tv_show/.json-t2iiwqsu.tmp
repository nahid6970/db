        "title": "Ben 10",
        "year": "2005",
        "overview": "When 10-year-old Ben Tennyson discovers a mysterious device, he gains the power to change into ten different alien heroes, each with uniquely awesome powers. With such abilities at his disposal, Ben realizes a greater responsibility to help others and stop evildoers, but that doesn't mean he's above a little superpowered mischief now and then.",
        "cover_image": "https://image.tmdb.org/t/p/w500/eogRp6oAPK0SEvQmCrQ78LTlSdp.jpg",
        "directory_path": "",
        "genres": [
            "Animation",
            "Sci-Fi & Fantasy",
            "Action & Adventure",
            "Comedy",
            "Kids"
        ],
        "rating": 4,
        "tmdb_rating": 8.1,
        "status": "Ended",
        "episodes": [
            {
                "season_number": 4,
