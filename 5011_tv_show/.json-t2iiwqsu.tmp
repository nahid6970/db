            },
            {
                "season_number": 2,
                "episode_number": 2,
                "title": "Proper Preparation and Planning",
                "air_date": "2020-09-04",
                "airtime": "18:00",
                "air_datetime": "2020-09-04T12:00:00+00:00",
                "overview": "The Boys get themselves a Super Terrorist, Starlight gets evidence against Vought, The Deep gets in touch with his feelings, and Homelander gets himself a family (sort of).\u00a0 All that, and a hard-hitting expos\u00e9 on why Super Suits don't have pockets.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/271/678565.jpg",
                "tvmaze_episode_id": 1855138,
                "id": 10,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 2,
                "episode_number": 1,
                "title": "The Big Ride",
                "air_date": "2020-09-04",
                "airtime": "18:00",
                "air_datetime": "2020-09-04T12:00:00+00:00",
                "overview": "Season 2! New and improved! Now with 50% more explosive decapitations, terrorists, S&amp;M hookers, cults, and a new pine fresh scent! But wait, there's more! 2X MORE blood, guts and gore than the other leading brands! This exclusive offer is available only on Amazon Prime Video! Don't delay! Order now!With Butcher still missing, Hughie, Mother's Milk, Frenchie, and Kimiko are now fugitives, and Homelander and Vought are more powerful than ever. But just as the Boys are about to leave the country, they are pulled back into the fray.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/271/678566.jpg",
                "tvmaze_episode_id": 1855137,
                "id": 9,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 8,
                "title": "You Found Me",
                "air_date": "2019-07-26",
                "airtime": "18:00",
                "air_datetime": "2019-07-26T12:00:00+00:00",
                "overview": "The Deep has a close shave in Sandusky, Hughie and Annie have an argument, Frenchie, Mother's Milk, and Kimiko are captured, and Billy strikes back against Homelander the only way he can.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/206/515956.jpg",
                "tvmaze_episode_id": 1665502,
                "id": 8,
                "watched": true,
