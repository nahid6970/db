            },
            {
                "season_number": 1,
                "episode_number": 1,
                "title": "The Name of the Game",
                "air_date": "2019-07-26",
                "airtime": "18:00",
                "air_datetime": "2019-07-26T12:00:00+00:00",
                "overview": "In a world where super-powered \"Supes\" exist and can do whatever they want with the help of the corporation that supports them, normal men are powerless. But one man, Hughie Campbell, vows to fight back after a Supe accidentally kills his girlfriend. A shadowy figure, Billy Butcher, contacts Hughie and recruits the younger man to help him.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/206/515724.jpg",
