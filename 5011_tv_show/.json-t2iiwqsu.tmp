    {
        "id": 136,
        "tmdb_id": 115036,
        "external_ids": {
            "tmdb": 115036
        },
        "title": "The Book of Boba Fett",
        "year": "2021",
        "overview": "Legendary bounty hunter Boba Fett and mercenary Fennec Shand must navigate the galaxy\u2019s underworld when they return to the sands of Tatooine to stake their claim on the territory once ruled by Jabba the Hutt and his crime syndicate.",
