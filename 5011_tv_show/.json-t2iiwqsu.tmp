            {
                "season_number": 1,
                "episode_number": 12,
                "title": "Penguin Park",
                "air_date": "2022-06-25",
                "airtime": "20:00",
                "air_datetime": "2022-06-25T14:00:00+00:00",
                "overview": "Loid is burdened with one mission after another from WISE and comes home exhausted. He then hears neighbors gossiping that he's neglecting his family. Because he can't let anyone doubt them as a family for the sake of Operation Strix, he decides to take his family to the aquarium the next day they have off to show everyone that they get along. However, he is assigned another mission from WISE while he's there, and...Source: crunchyroll",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/541/1354228.jpg",
                "tvmaze_episode_id": 2305525,
                "id": 12,
