            },
            {
                "season_number": 1,
                "episode_number": 1,
                "title": "Cruelty",
                "air_date": "2019-04-06",
                "airtime": "20:30",
                "air_datetime": "2019-04-06T14:30:00+00:00",
                "overview": "It is the Taisho Period. Tanjiro Kamado is living a modest but blissful life in the mountains with his family. One day, when he returns from selling charcoal in town, he finds his family slaughtered in pools of blood after a demon attack. Tanjiro rushes down the snowy mountain with the sole survivor, his sister Nezuko, on his back. But on the way, Nezuko suddenly snarls, turning on Tanjiro",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/538/1347450.jpg",
                "tvmaze_episode_id": 1626929,
                "id": 1,
