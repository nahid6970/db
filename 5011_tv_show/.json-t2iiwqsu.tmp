            },
            {
                "season_number": 2,
                "episode_number": 4,
                "title": "Hidden Inventory, Part 4",
                "air_date": "2023-07-27",
                "airtime": "20:56",
                "air_datetime": "2023-07-27T14:56:00+00:00",
                "overview": "\"Let's go home, Riko-chan.\" The moment Geto extends a hand to Amanai, the worst that could possibly happen does. Geto is left dumbstruck as Toji Fushiguro makes his appearance. Toji then declares that he killed Satoru Gojo.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/487/1218796.jpg",
                "tvmaze_episode_id": 2589544,
                "id": 28,
                "watched": true,
