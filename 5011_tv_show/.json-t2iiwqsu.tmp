            },
            {
                "season_number": 5,
                "episode_number": 10,
                "title": "War Game | The Great Faction Battle",
                "air_date": "2024-12-12",
                "airtime": "21:30",
                "air_datetime": "2024-12-12T15:30:00+00:00",
                "overview": "Freya declares a War Game against the Hestia Famila. The terms are simple: if Freya wins, Bell will be hers. But if she loses? She will return to Heaven.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/547/1368857.jpg",
                "tvmaze_episode_id": 3019887,
                "id": 69,
