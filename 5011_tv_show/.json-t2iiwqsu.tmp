                "air_datetime": "2007-09-22T16:00:00+00:00",
                "overview": "While on a desert highway, the RV gets stolen by a group of modern-day pirates, who use it to go on a robbery.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/199/498904.jpg",
                "tvmaze_episode_id": 92287,
                "id": 44,
