    {
        "id": 140,
        "tmdb_id": 114410,
        "external_ids": {
            "tmdb": 114410
        },
        "title": "Chainsaw Man",
        "year": "2022",
        "overview": "Denji has a simple dream\u2014to live a happy and peaceful life, spending time with a girl he likes. This is a far cry from reality, however, as Denji is forced by the yakuza into killing devils in order to pay off his crushing debts. Using his pet devil Pochita as a weapon, he is ready to do anything for a bit of cash.",
        "cover_image": "https://image.tmdb.org/t/p/w500/npdB6eFzizki0WaZ1OvKcJrWe97.jpg",
        "directory_path": "",
        "genres": [
            "Animation",
            "Action & Adventure",
            "Sci-Fi & Fantasy",
            "Comedy"
        ],
        "rating": 4,
        "tmdb_rating": 8.5,
        "status": "Continuing",
        "episodes": [
            {
                "season_number": 1,
                "episode_number": 12,
                "title": "Katana vs. Chainsaw",
                "air_date": "2022-12-27",
                "airtime": "21:00",
                "air_datetime": "2022-12-27T15:00:00+00:00",
                "overview": "Sawatari sends the \"Ghost Devil\" after Hayakawa, and he's nearly killed before the \"Ghost Devil\" stops and hands him a cigarette with a message from Himeno. The words inside give Hayakawa the strength to kill the \"Ghost Devil\" and capture Sawatari.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/647/1618257.jpg",
                "tvmaze_episode_id": 2409322,
                "id": 12,
                "watched": true,
