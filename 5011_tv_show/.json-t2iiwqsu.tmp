                "title": "Episode 5",
                "air_date": "2022-12-22",
                "airtime": "18:00",
                "air_datetime": "2022-12-22T12:00:00+00:00",
                "overview": "Aguni has one thing on his mind; to find and kill the King of Spades. He's joined by Arisu and a determined high schooler named Akane Heiya.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/436/1090791.jpg",
