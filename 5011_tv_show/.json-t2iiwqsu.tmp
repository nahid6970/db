                "episode_number": 2,
                "title": "Master | Training",
                "air_date": "2024-10-10",
                "airtime": "21:30",
                "air_datetime": "2024-10-10T15:30:00+00:00",
                "overview": "Hedin will not allow Bell's date with Syr to proceed. Not until Bell can properly woo her; not until he learns... how to pick up girls in a dungeon.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/538/1347203.jpg",
                "tvmaze_episode_id": 3019879,
                "id": 61,
                "watched": false,
