    {
        "id": 119,
        "tmdb_id": 99966,
        "external_ids": {
            "tmdb": 99966
        },
        "title": "All of Us Are Dead",
        "year": "2022",
        "overview": "A high school becomes ground zero for a zombie virus outbreak. Trapped students must fight their way out \u2014 or turn into one of the rabid infected.",
        "cover_image": "https://image.tmdb.org/t/p/w500/pTEFqAjLd5YTsMD6NSUxV6Dq7A6.jpg",
        "directory_path": "",
        "genres": [
            "Action & Adventure",
            "Drama",
            "Sci-Fi & Fantasy"
        ],
        "rating": "4",
        "tmdb_rating": 8.3,
        "status": "Continuing",
        "episodes": [
            {
                "season_number": 1,
                "episode_number": 12,
                "title": "Episode 12",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "The students make it to the quarantine camp, each of them weighed down by tragic loss. Months later, they hang on to hope for a survivor.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982494.jpg",
                "tvmaze_episode_id": 2266721,
                "id": 12,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 11,
                "title": "Episode 11",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "Though a surprise protector provides the group safe passage to their next stop, Yoon Gwi-nam is not far behind. The military makes a grave decision.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982493.jpg",
                "tvmaze_episode_id": 2266720,
                "id": 11,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 10,
                "title": "Episode 10",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "The auditorium quickly becomes a trap for the two newly united teams of survivors. Byeong-chan's video logs reveal a drastic solution to the crisis.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982492.jpg",
                "tvmaze_episode_id": 2266719,
                "id": 10,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 9,
                "title": "Episode 9",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "A disturbance at the camp shifts the military's understanding of the virus. A thunderstorm provides cover as the group agrees to keep on moving.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982491.jpg",
                "tvmaze_episode_id": 2266718,
                "id": 9,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 8,
                "title": "Episode 8",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "Jae-ik and his crew run into a student from the school. Na-yeon works up the courage to face her peers. The group shares confessions around a fire.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982490.jpg",
                "tvmaze_episode_id": 2255567,
                "id": 8,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 7,
                "title": "Episode 7",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "To make it out of the music room and onto the roof, the students put into action their most perilous plan yet. Elsewhere, Jae-ik comes across a setback.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982489.jpg",
                "tvmaze_episode_id": 2255566,
                "id": 7,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 6,
                "title": "Episode 6",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "The group clears a path to Cheong-san using sound to draw away zombies, but a new type of threat surfaces. Nam So-ju breaks out of the quarantine camp.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982488.jpg",
                "tvmaze_episode_id": 2255565,
                "id": 6,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 5,
                "title": "Episode 5",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "Martial law is imposed on the city. When Cheong-san is separated from the rest of the group, On-jo leads a mission to use a drone to locate him.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982487.jpg",
                "tvmaze_episode_id": 2255564,
                "id": 5,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 4,
                "title": "Episode 4",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "In need of a cellphone, two students take a risky journey to the teachers' office. Byeong-chan passes on critical information to Detective Song Jae-ik.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982486.jpg",
                "tvmaze_episode_id": 2255563,
                "id": 4,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 3,
                "title": "Episode 3",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "When one of the group is scratched while fighting a zombie, Lee Na-yeon demands they kick him out. Outside, the virus swallows up the city.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982485.jpg",
                "tvmaze_episode_id": 2255562,
                "id": 3,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 2,
                "title": "Episode 2",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "The infected multiply in droves. Scrambling for their lives, Nam On-jo and Lee Cheong-san find safety with others inside a classroom \u2014 but not for long.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982484.jpg",
                "tvmaze_episode_id": 2255561,
                "id": 2,
                "watched": true,
                "notify": "seen"
            },
            {
                "season_number": 1,
                "episode_number": 1,
                "title": "Episode 1",
                "air_date": "2022-01-28",
                "airtime": "18:00",
                "air_datetime": "2022-01-28T12:00:00+00:00",
                "overview": "Inside Lee Byeong-chan's science lab, a student incurs a seemingly harmless bite. Shortly after, a fast-spreading outbreak soaks the school in blood.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/392/982483.jpg",
                "tvmaze_episode_id": 2213071,
                "id": 1,
                "watched": true,
                "notify": "seen"
            }
        ],
        "tvmaze_id": 47199,
        "episode_source": "tvmaze",
