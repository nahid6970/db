            {
                "season_number": 2,
                "episode_number": 5,
                "title": "Move Forward!",
                "air_date": "2021-11-14",
                "airtime": "20:15",
                "air_datetime": "2021-11-14T14:15:00+00:00",
                "overview": "The battle with Enmu continues as Inosuke, Zenitsu and Rengoku awaken from the spell. Tanjiro and Inosuke try to pinpoint the demon's weak spot, while the others focus on protecting the passengers in the train.",
