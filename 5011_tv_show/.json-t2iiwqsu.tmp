                "air_date": "2019-07-26",
                "airtime": "18:00",
                "air_datetime": "2019-07-26T12:00:00+00:00",
                "overview": "Billy goes to a \"top man\" to figure out how to deal with Translucent's impenetrable skin. Madelyn seeks leverage on a Senate committee chairman, and Homelander begins acting on his own.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/206/515781.jpg",
                "tvmaze_episode_id": 1665496,
                "id": 2,
                "watched": true,
