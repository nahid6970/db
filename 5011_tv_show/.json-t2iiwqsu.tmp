            },
            {
                "season_number": 1,
                "episode_number": 97,
                "title": "Overwhelming Disadvantage",
                "air_date": "2019-08-20",
                "airtime": "15:25",
                "air_datetime": "2019-08-20T09:25:00+00:00",
                "overview": "The effects of the reincarnation spell had affected some of the Royal Knights back at the floating dungeon as well. Luck was fighting alongside Noelle when suddenly, he attacks his friends with extremely powerful magic. Meanwhile, Raia's magic is also enhanced from the spell and suddenly, the captain of the Aqua Deer, Rill, also appears before them. Just like Luck, his personality had changed and he attacks Asta and the others.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/211/527814.jpg",
                "tvmaze_episode_id": 1683578,
                "id": 97,
