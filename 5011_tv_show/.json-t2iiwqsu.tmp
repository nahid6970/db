                "title": "The Innocents",
                "air_date": "2019-07-26",
                "airtime": "18:00",
                "air_datetime": "2019-07-26T12:00:00+00:00",
                "overview": "Mother's Milk finds a Supe who can read the Woman's mind and find out her backstory. Vought forces the Deep to go public about his sexual harassment of Starlight, and Annie and Hughie make plans for a trip to the Bahamas.",
                "still_image": "https://static.tvmaze.com/uploads/images/original_untouched/206/515951.jpg",
                "tvmaze_episode_id": 1665500,
                "id": 6,
                "watched": true,
